# ============================================================================
# Brix Campus Market 环境变量示例（复制为 .env.bat / 系统环境变量后按需修改）
# 后端 application.yml 全部通过占位符读取，源码中不硬编码任何真实凭据。
# ============================================================================

# ---------------------------- 数据库（必须配置） ----------------------------
# 默认值 brix / brix123，对应 db/schema.sql 文末注释里的应用账号
DB_USERNAME=brix
DB_PASSWORD=brix123
DB_HOST=localhost
DB_PORT=3306
DB_NAME=brix_campus

# ---------------------------- AI（留空即降级） ----------------------------
# 留空 → 不创建 ChatModel → 自动走本地规则估价（PRD J03），启动不报错
AI_API_KEY=
# DeepSeek：https://api.deepseek.com/v1 ；通义：https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_DAILY_LIMIT=20
AI_TIMEOUT_SECONDS=10

# ---------------------------- 安全与上传 ----------------------------
# 长度需 ≥32 字符；生产环境务必替换
JWT_SECRET=dev-local-brix-campus-secret-key-0123456789
JWT_EXPIRE_HOURS=24
# 相对 backend/ 工作目录
FILE_UPLOAD_DIR=./uploads

# ---------------------------- 业务参数 ----------------------------
SERVER_PORT=8080
ORDER_UNPAID_TIMEOUT_MINUTES=30
TRADE_CODE_MAX_FAIL=5

# ---------------------------- 前端（.env.development，仅 dev） ----------------------------
# VITE_API_BASE=/api
# VITE_BACKEND=http://localhost:8080
